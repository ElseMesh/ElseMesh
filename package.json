{
	"name": "elsemesh",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5189",
    "prebuild": "node tools/require-external-build-tree.mjs",
    "build": "node tools/build.mjs",
    "prestart": "node tools/require-external-build-tree.mjs",
    "start": "node tools/build.mjs --run --install-if-needed",
    "preview": "vite preview",
    "test:world-gateway": "node test/world-gateway-e2e.mjs",
    "test:world-resolver": "node cloudflare/world-resolver/test.mjs",
    "test:browser-host-client": "node test/browser-host-client.mjs",
    "test:account-client": "node test/account-client.mjs",
    "test:webgl-backend": "node test/webgl-backend.mjs",
    "test:webgl-content": "node test/webgl-boat-adapter.mjs && node test/webgl-fish-stand-adapter.mjs && node test/webgl-fish-props-adapter.mjs && node test/webgl-game-adapter.mjs && node test/webgl-wildlife-adapter.mjs && node test/webgl-swash-probe.mjs",
    "test:wildlife-runtime": "node test/wildlife-runtime.mjs && node test/wildlife-frame.mjs",
    "export:island": "node tools/export-island.mjs",
		"export:grass-density": "node tools/export-grass-density.mjs",
		"export:burning-horizons": "node tools/export-loz-underneath.mjs",
    "test:burning-horizons": "node test/loz-underneath-world.mjs",
    "test:two-worlds": "node test/serve-world-profile-e2e.mjs",
    "test": "node tools/run-tests.mjs"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "webgpu": "^0.6.1"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "three": "^0.180.0",
    "zod": "^4.6.5"
  }
}
