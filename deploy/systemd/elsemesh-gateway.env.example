# Replace with the public HTTPS origin that matches the Caddy site hostname.
ELSEMESH_PUBLIC_GATEWAY=https://world.example.org
# Optional: systemd word-splits this into repeatable thruholdd arguments.
# Example: --webrtc-stun-server stun:stun.example.net:3478
# ELSEMESH_WEBRTC_STUN_ARGS="--webrtc-stun-server stun:stun.example.net:3478"
