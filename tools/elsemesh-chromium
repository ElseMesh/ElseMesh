#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat <<'EOF'
Usage: tools/elsemesh-chromium [URL]

Open ElseMesh in a dedicated Chromium profile and explicitly select its WebGL
renderer. This launcher does not enable unsafe WebGPU or force a graphics
backend. The default URL is https://elsemesh.org/?quality=1.

Set CHROMIUM to choose the Chromium executable and
ELSEMESH_CHROMIUM_PROFILE to choose its isolated profile directory.
EOF
}

url=https://elsemesh.org/?quality=1
if [[ $# -gt 1 ]]; then
	echo "Only one URL may be specified." >&2
	usage >&2
	exit 2
fi
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
	usage
	exit 0
fi
if [[ $# -eq 1 ]]; then
	url=$1
fi

# Force the renderer query parameter while preserving other query parameters
# and any URL fragment.
if [[ $url =~ ^([^#]*[?\&]renderer=)[^\&#]*(.*)$ ]]; then
	url="${BASH_REMATCH[1]}webgl${BASH_REMATCH[2]}"
else
	fragment=
	if [[ $url == *#* ]]; then
		fragment="#${url#*#}"
		url=${url%%#*}
	fi
	separator='?'
	if [[ $url == *\?* ]]; then separator='&'; fi
	url="${url}${separator}renderer=webgl${fragment}"
fi

chromium=${CHROMIUM:-}
if [[ -z $chromium ]]; then
	for candidate in chromium chromium-browser google-chrome; do
		if command -v "$candidate" >/dev/null 2>&1; then
			chromium=$(command -v "$candidate")
			break
		fi
	done
fi

if [[ -z $chromium ]]; then
	echo "Chromium was not found. Set CHROMIUM to its executable path." >&2
	exit 1
fi

profile=${ELSEMESH_CHROMIUM_PROFILE:-${XDG_DATA_HOME:-$HOME/.local/share}/elsemesh/chromium-webgl}
mkdir -p "$profile"

exec "$chromium" \
	--user-data-dir="$profile" \
	--no-first-run \
	--no-default-browser-check \
	--disable-sync \
	--disable-extensions \
	--new-window "$url"
